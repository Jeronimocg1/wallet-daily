# ─── BudgetBakers Wallet API ──────────────────────────────────────────────────
# Get your token: Wallet app → Settings → API Tokens
WALLET_API_TOKEN=your_wallet_api_token_here

# Optional — override the default API URL
# WALLET_API_URL=https://rest.budgetbakers.com/wallet

# ─── Anthropic Claude API ────────────────────────────────────────────────────
# Get your key: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Push Notifications (ntfy) ───────────────────────────────────────────────
# Free push notifications via https://ntfy.sh
# 1. Install the ntfy app on your phone (iOS/Android)
# 2. Set a unique topic name below (e.g. wallet-daily-yourname-abc123)
# 3. Subscribe to that topic in the app
# No account required for basic use.
NTFY_TOPIC=wallet-daily-yourname-abc123

# Optional — use a self-hosted ntfy server instead of ntfy.sh
# NTFY_SERVER=https://ntfy.sh

# ─── Reports ──────────────────────────────────────────────────────────────────
# Directory where daily markdown reports are saved (created if it doesn't exist)
# Windows example: C:\Users\YourName\Documents\BudgetReports\daily
# Mac/Linux example: /Users/yourname/Documents/budget-reports
REPORTS_DIR=./reports
